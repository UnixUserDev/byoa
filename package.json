{
  "name": "byoa",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "BYOA - a bring-your-own-agent, local-first coding agent harness",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "byoa": "./bin/byoa.ts"
  },
  "scripts": {
    "start": "node bin/byoa.ts",
    "test": "tsc --noEmit && node --experimental-ffi --test \"test/**/*.test.ts\"",
    "test:only": "node --experimental-ffi --test \"test/**/*.test.ts\"",
    "smoke": "node --experimental-ffi --test \"test/smoke/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "esbuild bin/byoa.ts --bundle --platform=node --format=esm --target=node26 --external:@opentui/core --outfile=dist/byoa.js",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "optionalDependencies": {
    "@opentui/core": "0.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
